        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - picket_stats_snapshot_updated",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
