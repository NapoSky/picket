  "cards": [
    {
      "dot": "cyan",
      "title": "What does your export contain?",
      "items": [
        "Your guild’s settings and permissions, timers, war-log subscriptions and currently retained journals.",
        "For voice: tracking preferences and a per-member summary over 60 days, with pending events counted separately.",
        "No todolist content, raw voice events, secrets or login sessions.",
        "Private administrator export; PICKET keeps no copy. Limit: 10 MiB or Discord’s lower attachment limit."
      ]
    },
    {
      "dot": "amber",
      "title": "When does data expire?",
      "items": [
        "7 days: records preventing a command from being processed twice.",
        "30 days: audit journals, timer action history and guild usage logs.",
        "Rolling 60 days: voice activity and associated names/channels. Reports already exclude older data.",
        "Expired or struck timers: 24 h by default, configurable. Empty inactive boards: 30 days.",
        "Completed war-log deliveries are cleaned after one day; public game state has separate retention.",
        "Jobs perform deletion. An outage can delay them without widening the voice report window."
      ]
    },
    {
      "dot": "rose",
      "title": "Erasure and remaining copies",
      "items": [
        "Bot removal or guild deletion: erase after 30 days by default. A requested deletion needs explicit cancellation before the deadline.",
        "Voice erasure removes SQL history and pending disk events; admin results become inaccessible until rebuilt.",
        "Opting out stops future collection; erasing history is a separate action.",
        "An older backup may retain other data until rotation. Raw voice history, sessions and admin snapshots are excluded from standard backups.",
        "PICKET cannot delete your downloaded file or copies transferred elsewhere. Discord messages also have their own lifecycle."
      ]
    }
  ]
