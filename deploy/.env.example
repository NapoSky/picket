# Copier en `.env` (ignoré par git) à côté de compose.yml.
# Image publiée par la CI ; rollout.sh la reçoit aussi en argument.
PICKET_IMAGE=ghcr.io/OWNER/picket:latest

# Nom d'hôte public servant POST /interactions (sous-domaine dédié, voir la documentation Cloudflare).
PICKET_HOST=picket.example.org

# Application Discord (Developer Portal > General Information).
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

# À adapter à votre Traefik existant.
TRAEFIK_NETWORK=proxy
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt

LOG_LEVEL=info

# Délai entre la désactivation d'une guilde et la suppression définitive de ses données (jours).
GUILD_RETENTION_DAYS=30

# Nombre de shards Gateway (1 jusqu'à ~2 500 serveurs). Chaque réplique candidate à chaque shard ; une seule le tient.
SHARD_COUNT=1
