{
  "name": "picket",
  "version": "1.1.0-rc.1",
  "private": true,
  "description": "PICKET - Discord bot for Foxhole regiments (todo lists, timers, war log, voice statistics and temporary voice channels)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "i18n:keys": "node scripts/generate-i18n-keys.js",
    "docs:dev": "pnpm --filter @picket/docs dev",
    "docs:build": "pnpm --filter @picket/docs build",
    "docs:diagrams": "node scripts/generate-doc-diagrams.mjs",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm typecheck && jest --selectProjects unit",
    "test:int": "jest --selectProjects integration --maxWorkers=4",
    "test:all": "pnpm typecheck && jest",
    "test:arch": "jest --selectProjects unit tests/architecture",
    "test:coverage": "jest --selectProjects unit --coverage",
    "stats:dev": "pnpm build && vite --config packages/stats/vite.config.mjs",
    "stats:dev:live": "pnpm stats:dev:prepare && node --env-file=.env.example --env-file=.env.dev apps/stats/dist/cli.js",
    "stats:test": "pnpm typecheck && jest --selectProjects unit --testPathPatterns='packages/stats|apps/stats|packages/config/tests|tests/deploy/init-secrets.test.ts|tests/deploy/backup.test.ts|tests/deploy/stats-dev-live.test.ts|tests/deploy/stats-preview.test.ts'",
    "stats:test:int": "jest --selectProjects integration --testPathPatterns='packages/stats|apps/stats|apps/bot/tests/stats-data.int.test.ts|packages/guild/tests/export.int.test.ts' --maxWorkers=4",
    "stats:test:load": "jest --config jest.load.config.js --runTestsByPath packages/stats/tests/load.int.test.ts --maxWorkers=1",
    "stats:dev:prepare": "docker compose -f compose.dev.yml up -d --wait && pnpm build && node --env-file=.env.example --env-file=.env.dev apps/bot/dist/cli.js migrate",
    "stats:dev:oauth": "pnpm stats:dev:prepare && node --env-file=.env.example --env-file=.env.dev apps/stats/dist/main.js"
  },
  "devDependencies": {
    "@picket/testing": "workspace:*",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.5",
    "jest": "^30.5.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
