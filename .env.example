# Développement local : `node --env-file=.env apps/bot/dist/main.js` (après `pnpm build`).
# Les secrets restent dans .env (ignoré par git) ; ne rien committer ici.
NODE_ENV=development
LOG_LEVEL=debug

# Developer Portal > votre application de DEV (jamais celle de production).
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Valeurs du compose.dev.yml.
DATABASE_URL=postgres://picket_app:app@127.0.0.1:5432/picket
DATABASE_MIGRATOR_URL=postgres://picket_migrator:migrator@127.0.0.1:5432/picket
DATABASE_APP_ROLE=picket_app
