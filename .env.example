# Développement local : `node --env-file=.env.dev apps/bot/dist/main.js` (après `pnpm build`).
# Copier vers .env.dev ; les secrets y restent (ignoré par git) ; ne rien committer ici.
NODE_ENV=development
TZ=Europe/Paris
# Admin voice dashboard snapshots, five-field cron in TZ. Member/officer views stay current.
STATS_ADMIN_REFRESH_CRON="0 0,12 * * *"
LOG_LEVEL=debug
ROLES=http-ingress,shard-runner,job-runner

# Developer Portal > votre application de DEV (jamais celle de production).
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# Same application's OAuth2 credential: production or `pnpm stats:dev:oauth` only.
# The `stats:dev:live` role simulator uses local sessions and needs no Discord credentials.
# DISCORD_CLIENT_SECRET=
# Alternatively use DISCORD_BOT_TOKEN_FILE / DISCORD_CLIENT_SECRET_FILE for local secret files.

# Valeurs du compose.dev.yml.
DATABASE_URL=postgres://picket_app:app@127.0.0.1:5432/picket
DATABASE_MIGRATOR_URL=postgres://picket_migrator:migrator@127.0.0.1:5432/picket
DATABASE_APP_ROLE=picket_app

# Include warlog-poller in ROLES to run the shared collector.
WAR_API_URL=https://war-service-live.foxholeservices.com
WAR_LOG_POLL_INTERVAL=15

# Dedicated stats HTTP process; run the bot separately. OAuth: `pnpm stats:dev:oauth`. Register http://localhost:8082/auth/callback in OAuth2 redirects.
# Use the SAME application's real OAuth2 client secret; it does not select administrators.
DASHBOARD_URL=http://localhost:8082
DASHBOARD_POOL_MAX=2
STATS_BUFFER_PATH=./data/voice-buffer
STATS_BUFFER_MAX_MIB=128
