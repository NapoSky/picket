{
  "uid": "picket-overview",
  "title": "PICKET \u2014 Overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "PICKET"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "PICKET dashboards",
      "type": "dashboards",
      "tags": [
        "PICKET"
      ]
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Running versions",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_build_info",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Ready replicas",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(service)(picket_ready)",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Connected / expected shards",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(picket_shards_connected) / clamp_min(max(picket_shards_expected),1)",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Role leaders",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(component)(picket_role_leader)",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Backup age (hours)",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(time() - picket_backup_last_success) / 3600",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Active incident signals",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{__name__=~\"picket:incident:.*\"} > 0",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 100,
      "type": "logs",
      "title": "Operational logs (sanitized, outside data exports)",
      "datasource": {
        "type": "loki",
        "uid": "picket-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"picket|picket-stats\"} | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
