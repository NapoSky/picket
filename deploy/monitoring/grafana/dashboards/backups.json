{
  "uid": "picket-backups",
  "title": "PICKET \u2014 Backups",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "PICKET"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "PICKET dashboards",
      "type": "dashboards",
      "tags": [
        "PICKET"
      ]
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Last successful backup",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_backup_last_success",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Last attempt",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_backup_last_attempt",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Last backup duration",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_backup_duration_seconds",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Unresolved failure since",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_backup_failure_since",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Completed archives",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_backup_archives",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Encrypted backup bytes",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_backup_bytes",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Last isolated restore check",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_restore_last_verified",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 100,
      "type": "logs",
      "title": "Operational logs (sanitized, outside data exports)",
      "datasource": {
        "type": "loki",
        "uid": "picket-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"picket|picket-stats\"} | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
