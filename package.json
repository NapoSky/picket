{
  "name": "picket",
  "version": "0.0.0",
  "private": true,
  "description": "PICKET - Discord bot for Foxhole regiments (todolists, timers, war-log)",
  "license": "PolyForm-Noncommercial-1.0.0",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "i18n:keys": "node scripts/generate-i18n-keys.js",
    "docs:dev": "pnpm --filter @picket/docs dev",
    "docs:build": "pnpm --filter @picket/docs build",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm typecheck && jest --selectProjects unit",
    "test:int": "jest --selectProjects integration",
    "test:all": "pnpm typecheck && jest",
    "test:arch": "jest --selectProjects unit tests/architecture",
    "test:coverage": "jest --selectProjects unit --coverage"
  },
  "devDependencies": {
    "@picket/testing": "workspace:*",
    "@swc/core": "^1.16.13",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.4",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
