{
  "uid": "picket-database",
  "title": "PICKET \u2014 Database and coordination",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "tags": [
    "PICKET"
  ],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "links": [
    {
      "title": "PICKET dashboards",
      "type": "dashboards",
      "tags": [
        "PICKET"
      ]
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Pool connections",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_pool_total",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Idle pool connections",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_pool_idle",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Pool waiters",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "picket_pool_waiting",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Pool acquisition p95",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,service)(rate(picket_operation_duration_seconds_bucket{operation=\"database_acquire\"}[5m])))",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Query duration p95",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,service)(rate(picket_operation_duration_seconds_bucket{operation=\"database_query\"}[5m])))",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Lease results",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(operation,component,outcome)(rate(picket_operations_total{operation=~\"lease_acquire|lease_renew\"}[5m]))",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "PostgreSQL connections",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(pg_stat_database_numbackends)",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Database locks",
      "datasource": {
        "type": "prometheus",
        "uid": "picket-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(mode)(pg_locks_count)",
          "legendFormat": "{{service}} {{component}} {{outcome}} {{job}} {{version}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1
          }
        },
        "overrides": []
      }
    },
    {
      "id": 100,
      "type": "logs",
      "title": "Operational logs (sanitized, outside data exports)",
      "datasource": {
        "type": "loki",
        "uid": "picket-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"picket|picket-stats\"} | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
