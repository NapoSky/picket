# Copy to `.env` (ignored by git) next to compose.yml.
# Image published by CI; rollout.sh also accepts it as an argument.
PICKET_IMAGE=ghcr.io/OWNER/picket:latest

# Public hostname serving POST /interactions (dedicated subdomain proxied by Cloudflare; see the documentation).
PICKET_HOST=picket.example.org

# Discord application (Developer Portal > General Information).
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=

LOG_LEVEL=info

# Delay between a guild becoming inactive and permanent deletion of its data (days).
GUILD_RETENTION_DAYS=30

# Gateway shard count (1 for up to roughly 2,500 guilds). Every replica competes for each shard; only one holds it.
SHARD_COUNT=1

# Shared authenticated Discord budget per running replica (include rollout overlap).
# Reserve 5 RPS for deploy-commands and 5 RPS of margin: peak replicas × RPS <= 40.
# Default 20 supports one permanent replica + one during rollout.
DISCORD_REST_GLOBAL_RPS=20

# Maximum PostgreSQL connections per bot replica. Budget every overlapping replica
# plus CLI, migration, backup, and administrative headroom against PostgreSQL capacity.
DATABASE_POOL_MAX=10

# Encrypted backups beside deploy/. Create this directory (mode 700) before rollout.
# Keep the five newest successful backups (daily and pre-migration combined), at most 30 days old.
# Only the public age1... recipient goes in secrets/backup_recipients.
# init-secrets.sh creates both keys. Move secrets/backup_identity to a vault for
# restoration, then remove it from the host; keep secrets/backup_recipients here.
BACKUP_DIR=../backups
