    {
      "id": 100,
      "type": "logs",
      "title": "Operational logs (sanitized, outside data exports)",
      "datasource": {
        "type": "loki",
        "uid": "picket-loki"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service=~\"picket|picket-stats\"} | json",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "sortOrder": "Descending",
        "wrapLogMessage": true
      }
    }
  ]
}
